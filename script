#Query
--Why are some products selling better than others?
SELECT C.state, O.customer_id, P.product_name, P.model_year, P.price, P.product_id, SUM(O.quantity*O.price) AS revenue
FROM Orders O, Customers C 
LEFT JOIN Products P  
ON O.product_id = P.product_id
GROUP BY P.product_id
ORDER BY revenue DESC
LIMIT 5
