#Query
--Are there states with many customers but low revenue?
SELECT C.state, O.customer_id, O.quantity, SUM(O.quantity*O.price) AS revenue
FROM Orders O
LEFT JOIN Customers C  
ON O.customer_id = C.customer_id
GROUP BY C.state
ORDER BY revenue ASC
LIMIT 5
